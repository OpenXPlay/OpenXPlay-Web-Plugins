                "required": [
                  "en"
                ],
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            },
            "required": [
              "id",
              "kind",
              "entry",
              "usage"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "kind": {
                "const": "panel"
              },
              "entry": {
                "type": "string",
                "minLength": 1,
