    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "attributions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "links": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^https?://[^\\s]+$"
                }
              },
              "required": [
                "label",
                "url"
              ]
            }
          }
        },
        "required": [
          "text"
        ]
