  "required": [
    "spec",
    "id",
    "version",
    "license",
    "name",
    "description",
    "icon",
    "permissions",
    "surfaces",
    "quickActions"
  ],
  "additionalProperties": true,
  "description": "The launcher shows one plugin tile using icon and localized name. Its primary surface is the first panel, else first companion (else first surface). Secondary surfaces and quick actions live in a plugin detail view; surface label is optional with a localized kind/ordinal fallback. Companion iframe and document canvases are transparent with light color-scheme, and placement avoids receiver gear and host dock rectangles."
}
