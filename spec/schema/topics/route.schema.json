{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oxp-web-plugin:0:topic-route",
  "anyOf": [
    {
      "type": "null"
    },
    {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "destination": {
          "type": [
            "string",
            "null"
          ]
        },
        "etaMs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "distanceRemainingM": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maneuver": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 255
                },
                "road": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "distanceM": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "required": [
                "type",
                "road",
                "distanceM"
              ],
              "additionalProperties": true
            }
          ]
        },
        "appName": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "active",
        "destination",
        "etaMs",
        "distanceRemainingM",
        "maneuver",
        "appName"
      ],
      "additionalProperties": true
    }
  ]
}
