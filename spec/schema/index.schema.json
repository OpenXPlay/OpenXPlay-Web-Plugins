{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oxp-web-plugin:0:index",
  "type": "object",
  "properties": {
    "spec": {
      "const": "oxp-web-plugin/0"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
          },
          "manifest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^/plugins/p/[a-z0-9.-]+/oxp-plugin\\.json$"
          }
        },
        "required": [
          "id",
          "version",
          "manifest"
        ],
        "additionalProperties": true
      },
      "maxItems": 256
    }
  },
  "required": [
    "spec",
    "plugins"
  ],
  "additionalProperties": true
}
