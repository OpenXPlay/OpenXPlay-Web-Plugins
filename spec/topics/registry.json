    {
      "id": "parked",
      "version": 1,
      "schema": "spec/schema/topics/parked.schema.json",
      "permission": null,
      "provider": "host",
      "updates": {
        "snapshot": "full",
        "queue": "latest-only",
        "maxRateHz": 4
      },
      "unavailable": {
        "unsupported": "absent-from-topics",
        "unknown": "value-null"
      }
    },
    {
      "id": "audioSource",
      "version": 1,
      "schema": "spec/schema/topics/audioSource.schema.json",
      "permission": "audioSource",
      "provider": "relay",
      "updates": {
        "snapshot": "full",
        "queue": "latest-only",
        "maxRateHz": 4
