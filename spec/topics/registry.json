{
  "spec": "oxp-web-plugin/0",
  "normative": true,
  "permissions": [
    "session",
    "nowPlaying",
    "nowPlaying.artwork",
    "call",
    "activity",
    "storage",
    "route",
    "motion",
    "audioSource"
  ],
  "contract": {
    "availability": "Absent from the provider available-topic list means unsupported or disabled. Listed with value null means supported, current value unknown. Availability is independent of value. Provider list replacement removes cached values.",
    "delivery": "Full snapshots, latest-only per topic, at most 4 updates/second. Host merges providers into one permission-filtered store; plugins never select providers. Host-local clock/theme/locale are not topics.",
    "parked": "Available unconditionally. Speed < 0.5 m/s continuously for 5000 ms yields parked/speed; speed > 2 m/s yields moving/speed and clears manual confirmation. Otherwise manual confirmation applies, else unknown. Missing/null motion resets the low-speed interval. Manual confirmation retains session/navigation/30-minute expiry rules.",
    "messages": "Receiver init.topics is optional, defaults to []. geometry.topics optionally replaces availability later. Receiver state {topic,value} only accepts advertised receiver topics. Relay welcome.topics replaces relay availability; only advertised relay states accepted. Plugin welcome.topics and topics {topics} carry permission-filtered availability; removal deletes cached state without emitting null."
  },
  "topics": [
    {
      "id": "session",
      "version": 1,
      "schema": "spec/schema/topics/session.schema.json",
      "permission": "session",
      "provider": "relay",
      "updates": {
        "snapshot": "full",
        "queue": "latest-only",
        "maxRateHz": 4
      },
      "unavailable": {
        "unsupported": "absent-from-topics",
        "unknown": "value-null"
      }
    },
    {
      "id": "nowPlaying",
      "version": 1,
      "schema": "spec/schema/topics/nowPlaying.schema.json",
      "permission": "nowPlaying",
      "provider": "relay",
      "updates": {
        "snapshot": "full",
        "queue": "latest-only",
        "maxRateHz": 4
      },
      "unavailable": {
        "unsupported": "absent-from-topics",
        "unknown": "value-null"
      }
    },
    {
      "id": "call",
      "version": 1,
      "schema": "spec/schema/topics/call.schema.json",
      "permission": "call",
      "provider": "relay",
      "updates": {
        "snapshot": "full",
        "queue": "latest-only",
        "maxRateHz": 4
      },
      "unavailable": {
        "unsupported": "absent-from-topics",
        "unknown": "value-null"
      }
    },
    {
      "id": "activity",
      "version": 1,
      "schema": "spec/schema/topics/activity.schema.json",
      "permission": "activity",
      "provider": "relay",
      "updates": {
        "snapshot": "full",
        "queue": "latest-only",
        "maxRateHz": 4
      },
      "unavailable": {
        "unsupported": "absent-from-topics",
        "unknown": "value-null"
      }
    },
    {
      "id": "route",
      "version": 1,
      "schema": "spec/schema/topics/route.schema.json",
      "permission": "route",
      "provider": "relay",
      "updates": {
        "snapshot": "full",
        "queue": "latest-only",
        "maxRateHz": 4
      },
      "unavailable": {
        "unsupported": "absent-from-topics",
        "unknown": "value-null"
      }
    },
    {
      "id": "motion",
      "version": 1,
      "schema": "spec/schema/topics/motion.schema.json",
      "permission": "motion",
      "provider": "receiver",
      "updates": {
        "snapshot": "full",
        "queue": "latest-only",
        "maxRateHz": 4
